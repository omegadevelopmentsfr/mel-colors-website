{
  "name": "mel-colors-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && opennextjs-cloudflare build --skipNextBuild",
    "preview": "npm run build && opennextjs-cloudflare preview",
    "deploy": "npm run build && opennextjs-cloudflare deploy",
    "upload": "npm run build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@gsap/react": "^2.1.1",
    "@opennextjs/cloudflare": "^1.19.6",
    "@react-three/drei": "^9.99.7",
    "@react-three/fiber": "^8.15.19",
    "framer-motion": "^11.0.8",
    "gsap": "^3.12.5",
    "lucide-react": "^1.14.0",
    "next": "^15.5.15",
    "react": "^18",
    "react-dom": "^18",
    "three": "^0.162.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.162.0",
    "eslint": "^8",
    "eslint-config-next": "^15.5.15",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wrangler": "^4.86.0"
  }
}
